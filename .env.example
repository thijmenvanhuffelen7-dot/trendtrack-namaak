# Kopieer naar .env.local en vul in. Nooit committen.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Directe Postgres-verbinding voor pg-boss (workers)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Web (publiek, mag in de browser)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Meta Ad Library API
META_ACCESS_TOKEN=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# MCP-server
MCP_PORT=3333

# Crawler: contactadres/URL in de User-Agent (verplicht netjes invullen in productie)
CRAWLER_CONTACT=https://jouwdomein.nl/bot

# Meta Ad Library: API-versie en landen voor ads.sync_advertiser
META_API_VERSION=v23.0
META_COUNTRIES=NL,BE

# E-mail library (seed-inboxen)
# Catch-all domein waarop elke shop een eigen adres krijgt
EMAIL_INBOX_DOMAIN=inbox.jouwdomein.nl
# webhook (Postmark/Mailgun naar /api/inbound/<provider>) of imap (workers pollen een mailbox)
EMAIL_INBOUND_MODE=webhook
# Postmark: zet dit als wachtwoord in de webhook-URL https://postmark:<secret>@<host>/api/inbound/postmark
INBOUND_WEBHOOK_SECRET=
# Mailgun: "HTTP webhook signing key" uit het Mailgun-dashboard
MAILGUN_WEBHOOK_SIGNING_KEY=
# Alleen bij EMAIL_INBOUND_MODE=imap
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_SECURE=true
IMAP_POLL_SECONDS=30


# Workers: monitoring en planning
# Melding als >20% van de jobs in een uur faalt (bv. een n8n-webhook die mailt/Slackt)
ALERT_WEBHOOK_URL=
WORKER_HEALTH_PORT=8080
SCHEDULER_ENABLED=true
SCHEDULER_TZ=Europe/Amsterdam
KEYWORDS_PER_HOUR=3
CONCURRENCY_SHOP_DETECT=4
CONCURRENCY_SHOP_CRAWL_PRODUCTS=2
CONCURRENCY_SHOP_CRAWL_BESTSELLERS=2
CONCURRENCY_SHOP_SNAPSHOT=3
CONCURRENCY_ADS_SYNC=1
CONCURRENCY_ADS_DISCOVER=1

# Web: login
# Publieke URL van de web-app (voor links in mails en OAuth). Lokaal leeg laten.
NEXT_PUBLIC_SITE_URL=
# Zet op true zodra Google-login in Supabase is ingesteld (zie docs/auth.md)
NEXT_PUBLIC_GOOGLE_LOGIN=false

# Stripe: extra instellingen
# Betaalmethodes in Checkout (komma-gescheiden). Leeg = wat in het Stripe-dashboard aan staat.
STRIPE_PAYMENT_METHODS=card,ideal,bancontact
# Uitvoer van `pnpm --filter web stripe:setup` (portal waarin klanten zelf wisselen/opzeggen)
STRIPE_PORTAL_CONFIGURATION=

# MCP-server
# Publieke URL's (productie: https). De MCP-server stuurt clients voor OAuth naar de web-app.
MCP_PUBLIC_URL=http://localhost:3333
WEB_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_MCP_URL=http://localhost:3333

# Publieke site
# Contactadres op de site en in privacy/voorwaarden
NEXT_PUBLIC_CONTACT_EMAIL=hallo@jouwdomein.nl
# Geheim zout voor het hashen van IP-adressen (limieten gratis tools). Verplicht in productie: openssl rand -hex 32
RATE_LIMIT_SALT=

# Monitoring (optioneel). Sentry of GlitchTip-DSN; leeg = alleen loggen.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Commit-hash voor de release in foutmeldingen (Vercel zet VERCEL_GIT_COMMIT_SHA; op de VPS zelf zetten)
GIT_SHA=

# VPS: Caddy (HTTPS) en backups, zie docs/deploy.md
MCP_DOMAIN=mcp.jouwdomein.nl
CADDY_EMAIL=ops@jouwdomein.nl
# Dagelijkse pg_dump: aantal dagen bewaren, en optioneel een rclone-remote voor een kopie buiten de server
BACKUP_KEEP_DAYS=14
BACKUP_RCLONE_REMOTE=
