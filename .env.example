# Kopieer naar .env.local en vul in. Nooit committen.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Directe Postgres-verbinding voor pg-boss (workers)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Web (publiek, mag in de browser)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Meta Ad Library API
META_ACCESS_TOKEN=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# MCP-server
MCP_PORT=3333
